{
  "name": "eslint-config-lintastic",
  "version": "2.1.0",
  "description": "🛡️ DevSecOps ESLint Configuration - MVC Architecture with Functional Programming | OWASP Top 10 compliant with 47+ security rules | Modular & Scalable",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "node --run lint -- --fix",
    "test": "node --import ./tests/setupTest.js --test",
    "test:unit": "node --test ./tests/unit/*",
    "test:integration": "node --test ./tests/integration/*",
    "test:security": "node --test ./tests/samples/*",
    "test:watch": "node --run test -- --watch",
    "test:coverage": "npx c8 npm test",
    "security:scan": "node --run lint -- --ext .js src/ lib/",
    "security:report": "node --run test:security",
    "dev:inspect": "npx @eslint/config-inspector",
    "build:docs": "node scripts/generate-docs.js"
  },
  "imports": {
    "#lib/*": "./lib/*.js",
    "#src/*": "./src/*.js",
    "#tests/*": "./tests/*.js"
  },
  "files": [
    "src/**/*",
    "lib/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/veradeveloper916/eslint-config-lintastic.git"
  },
  "keywords": [
    "eslint",
    "devsecops", 
    "security",
    "sast",
    "owasp",
    "vulnerability-scanner",
    "static-analysis",
    "code-security",
    "eslint-config",
    "security-linting",
    "cybersecurity",
    "secure-development",
    "mvc-architecture",
    "functional-programming",
    "modular",
    "scalable",
    "nodejs-security",
    "security-automation"
  ],
  "author": "Esteban Vera (@veradeveloper916) <veradeveloper916>",
  "license": "MIT",
  "dependencies": {
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "eslint-plugin-jsdoc": "^61.0.0",
    "extensionless": "^1.9.9",
    "globals": "^16.4.0"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^1.0.0",
    "@eslint/js": "^9.18.0",
    "c8": "^10.1.3",
    "eslint": "^9.21.0"
  },
  "c8": {
    "exclude": [
      ".config.*"
    ],
    "include": [
      "src/",
      "lib/"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "all": true,
    "check-coverage": true,
    "branches": 0,
    "functions": 0,
    "lines": 0,
    "statements": 0
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/veradeveloper916/eslint-config-lintastic/issues"
  },
  "homepage": "https://github.com/veradeveloper916/eslint-config-lintastic#readme"
}
